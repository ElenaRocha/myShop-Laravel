{
    "mcpServers": {
        "postgres": {
            "type": "stdio",
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "-e",
                "DATABASE_URI",
                "crystaldba/postgres-mcp",
                "--access-mode=restricted"
            ],
            "env": {
                "DATABASE_URI": "postgresql://sail:password@host.docker.internal:5432/myshop"
            }
        },
        "laravel-boost": {
            "command": "vendor/bin/sail",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        }
    }
}